{
  "id": "blender-zbrush-mini",
  "title": "Intro to Blender & ZBrush",
  "category": "Game Development",
  "status": "published",
  "heading": "Intro to Blender & ZBrush Mini",
  "summary": "This course teaches students 3D modeling, sculpting, and basic 3D printing using Blender (free, open-source 3D software) and ZBrushCoreMini (a free digital sculpting tool). Students will progress from simple shapes to detailed models, learn to prepare files for 3D printing, and explore digital sculpting with a tablet. By the end, students will have a portfolio of printed and digital creations.",
  "objectives": [
    "Navigate the Blender interface and use essential modeling tools.",
    "Model 3D objects using extrude, inset, loop cut, and modifiers.",
    "Understand mesh topology, N-gons, and clean geometry.",
    "Prepare 3D models for printing: export, slice, and configure printer settings.",
    "Sculpt organic shapes in ZBrushCoreMini using various brushes.",
    "Complete a portfolio of 3D models suitable for printing or rendering."
  ],
  "intro_html": "<section>\n        <h3>System Requirements</h3>\n        <p>\n          <strong>Blender:</strong> Windows 8.1+ (64-bit), 4-core CPU with SSE4.2,\n          8 GB RAM minimum, GPU with 2 GB VRAM and OpenGL 4.3.\n          Blender is 100% free and open-source.\n        </p>\n        <p>\n          <strong>ZBrushCoreMini:</strong> Free download from Maxon. Tablet\n          (drawing tablet) recommended for sculpting but not required.\n        </p>\n      </section>",
