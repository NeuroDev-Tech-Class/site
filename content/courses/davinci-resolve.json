{
  "id": "davinci-resolve",
  "title": "Video Software - DaVinci Resolve",
  "category": "Media",
  "status": "published",
  "heading": "Video Software — DaVinci Resolve",
  "summary": "This course introduces students to professional video editing, color correction, and audio post-production using DaVinci Resolve, the free industry-standard software from Blackmagic Design used on Hollywood films and TV shows. Students will learn the full post-production workflow: importing media, editing on a timeline, adding transitions and titles, correcting color, mixing audio, and exporting a finished video. DaVinci Resolve runs on Windows, macOS, and Linux.",
  "objectives": [
    "Install DaVinci Resolve and set up a project with correct frame rate and resolution.",
    "Navigate the seven workspace pages: Media, Cut, Edit, Fusion, Color, Fairlight, and Deliver.",
    "Import, organize, and manage media in bins and the media pool.",
    "Edit video on a timeline using cuts, trims, transitions, and titles.",
    "Apply basic color correction and simple color grading.",
    "Edit and mix audio tracks using the Fairlight page.",
    "Export a finished video for YouTube, social media, or local playback."
  ],
  "intro_html": "<section>\n        <h3>System Requirements</h3>\n        <p>\n          <strong>DaVinci Resolve 20</strong> is free to download and use (a\n          paid Studio version exists, but is not required for this course).\n          It runs on Windows 10+, macOS 12.0+, and Linux. Minimum: 16 GB\n          RAM recommended, a dedicated GPU with 2+ GB VRAM, and a fast\n          storage drive (SSD preferred) for smooth video playback.\n        </p>\n      </section>",
