{
  "id": "unreal-engine",
  "title": "Intro to Unreal Engine",
  "category": "Game Development",
  "status": "published",
  "heading": "Intro to Unreal Engine",
  "summary": "This course introduces students to game development using Unreal Engine 5, the same engine behind Fortnite, Rocket League, and countless AAA titles. Students will learn to navigate the editor, build 3D environments, script gameplay with Blueprints, and design a complete playable level. No prior programming experience is required—everything is done visually with Blueprint nodes.",
  "objectives": [
    "Install and configure Unreal Engine 5 via the Epic Games Launcher.",
    "Navigate the editor viewport, content browser, and details panel.",
    "Build environments using static meshes, materials, landscapes, and foliage.",
    "Create interactive gameplay using the Blueprint visual scripting system.",
    "Design UI elements and HUDs using UMG Widget Blueprints.",
    "Plan, graybox, and polish a complete game level with win/lose mechanics."
  ],
  "intro_html": "<section>\n        <h3>System Requirements</h3>\n        <p>\n          <strong>Windows:</strong> Windows 10 64-bit, quad-core CPU (2.5 GHz+),\n          8 GB RAM minimum, DirectX 11/12 GPU.\n          <strong>macOS:</strong> macOS 13+, quad-core Intel, Metal 1.2 GPU.\n          Unreal Engine is free for students and educators.\n        </p>\n      </section>",
