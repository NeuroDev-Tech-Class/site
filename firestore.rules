rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role and status live in custom auth claims, synced from users/{uid} by the onUserWrite function
    function role() {
      return request.auth.token.get('role', '');
    }

    function isAdmin() {
      return signedIn() && role() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'superadmin';
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow read: if isAdmin();

      allow create: if signedIn() &&
                       request.auth.uid == userId && (
                         (request.resource.data.role == 'student' &&
                          request.resource.data.status == 'pending') ||
                         (request.resource.data.role == 'superadmin' &&
                          request.auth.token.email == 'neurodevtechcoach@gmail.com')
                       );

      // Students may only change their own course progress
      allow update: if signedIn() &&
                       request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courses']);

      allow update: if isAdmin() && roleUnchanged();
      allow update: if isSuperAdmin();
      allow delete: if isAdmin();
    }

    // Legacy Google Forms scores. Admins grade existing rows; nothing creates new ones.
    match /testResults/{email} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Certificate emails are queued by admins; approval emails come from onUserWrite
    match /mail/{docId} {
      allow create: if isAdmin();
    }

    // A grade may change only the grading fields; totalScore, passed and provisional are
    // written by onSubmissionWrite, which bypasses these rules.
    function validGrade() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
               .hasOnly(['manualScore', 'totalMax', 'feedback', 'status', 'gradedAt', 'gradedBy', 'updatedAt']) &&
             data.status == 'graded' &&
             data.manualScore is number && data.manualScore >= 0 &&
             (data.get('totalMax', null) == null ||
               (data.totalMax is number && data.totalMax > 0 && data.manualScore <= data.totalMax)) &&
             data.get('feedback', '') is string && data.get('feedback', '').size() <= 5000 &&
             data.gradedBy == request.auth.uid &&
             data.gradedAt == request.time;
    }

    // Created by the migration tool now and by students from Phase 3; students read their own.
    match /submissions/{id} {
      allow read: if isAdmin();
      allow read: if signedIn() && resource.data.studentUid == request.auth.uid;
      allow update: if isAdmin() && validGrade();
      allow create, delete: if false;
    }

    // testResults rows whose email matched no user, written by the migration tool
    match /legacyOrphans/{email} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
