{
  "name": "neurodev-tech-class-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-neurodev \"node --test 'tests/**/*.test.js'\"",
    "test:unit": "node --test 'tests/lib/**/*.test.js'",
    "test:rules": "firebase emulators:exec --only firestore --project demo-neurodev \"node --test 'tests/rules/**/*.test.js'\"",
    "emulators": "firebase emulators:start --only firestore,auth,functions,storage --project demo-neurodev"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.29.0",
    "jsdom": "^30.0.1"
  }
}
