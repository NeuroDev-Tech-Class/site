---
import CourseStart from '../../components/CourseStart'
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import { categoryKey, courseStats, itemLabel, publishedCourses, sanitize, unitHeading, type Course } from '../../lib/content'

export function getStaticPaths() {
  return publishedCourses().map(course => ({ params: { id: course.id }, props: { course } }))
}

const { course } = Astro.props as { course: Course }
const key = categoryKey(course.category)
const stats = courseStats(course)
---

<Base title={course.heading} description={course.summary}>
  <div style={`--accent: var(--cat-${key})`}>
    <section class="panel relative overflow-hidden" style="border-color: var(--accent)">
      <p class="mt-0 text-sm"><a href="/catalog">Course Catalog</a> <span aria-hidden="true">/</span> {course.category}</p>
      <div class="mt-4 flex items-start gap-4">
        <span class="icon-tile size-14"><Icon name={key} size={28} /></span>
        <div class="min-w-0">
          <h1 class="mt-0">{course.heading}</h1>
          <p class="mt-1 text-sm font-semibold text-(--muted)">{stats.units} units / {stats.items} items</p>
        </div>
      </div>
      <p class="mt-5 max-w-[70ch]">{course.summary}</p>
      <p class="mt-6">
        <CourseStart client:load courseId={course.id} />
      </p>
    </section>

    <h2>Course Objectives</h2>
    <ul class="mt-4 grid list-none gap-2 pl-0">
      {course.objectives.map(objective => (
        <li class="mt-0 flex gap-3">
          <Icon name="check" size={20} class="mt-1 shrink-0 text-(--accent)" />
          <span>{objective}</span>
        </li>
      ))}
    </ul>

    {course.intro_html && (
      <div class="panel mt-10 [&>:first-child]:mt-0 [&_:is(h2,h3):first-child]:mt-0">
        <Fragment set:html={sanitize(course.intro_html, { shiftHeadings: true })} />
      </div>
    )}

    {course.units.map(unit => {
      const heading = unitHeading(unit.title)
      return (
        <section class="panel mt-8">
          <div class="flex flex-wrap items-center gap-3">
            {heading.number && <span class="unit-pill">Unit {heading.number}</span>}
            <h2 class="mt-0 text-xl sm:text-2xl">{heading.title}</h2>
          </div>
          {unit.description && <p class="mt-2 text-(--muted)">{unit.description}</p>}
          <ol class="mt-4 list-none pl-0">
            {unit.items.map(item => {
              if (item.type === 'note') {
                return (
                  <li data-item class="mt-0 flex gap-3 border-t border-(--border) py-3 text-(--muted)">
                    <Icon name="note" size={18} class="mt-1 shrink-0" />
                    <div class="min-w-0" set:html={sanitize(String(item.payload.html ?? ''))} />
                  </li>
                )
              }
              const { label, title } = itemLabel(item)
              return (
                <li data-item class="mt-0 flex flex-col gap-1 border-t border-(--border) py-3 sm:flex-row sm:items-center sm:gap-4" style={`--t: var(--type-${item.type})`}>
                  <span class="flex w-36 shrink-0 items-center gap-2 font-heading text-xs font-bold tracking-[0.08em] text-(--t) uppercase">
                    <span class="grid size-7 place-items-center rounded-md" style="background: color-mix(in srgb, var(--t) 16%, transparent)">
                      <Icon name={item.type} size={16} />
                    </span>
                    {label}
                  </span>
                  <span class="min-w-0">{title}</span>
                </li>
              )
            })}
          </ol>
        </section>
      )
    })}
  </div>
</Base>
