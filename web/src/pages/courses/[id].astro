---
import CourseProgressPanel from '../../components/course/CourseProgressPanel'
import CourseUnits from '../../components/course/CourseUnits'
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import { categoryKey, courseStats, itemPages, publishedCourses, sanitize, unitViews, type Course } from '../../lib/content'

export function getStaticPaths() {
  return publishedCourses().map(course => ({ params: { id: course.id }, props: { course } }))
}

const { course } = Astro.props as { course: Course }
const key = categoryKey(course.category)
const stats = courseStats(course)
---

<Base title={course.heading} description={course.summary}>
  <div style={`--accent: var(--cat-${key})`}>
    <section class="panel relative overflow-hidden" style="border-color: var(--accent)">
      <p class="mt-0 text-sm"><a href="/catalog">Course Catalog</a> <span aria-hidden="true">/</span> {course.category}</p>
      <div class="mt-4 flex items-start gap-4">
        <span class="icon-tile size-14"><Icon name={key} size={28} /></span>
        <div class="min-w-0">
          <h1 class="mt-0">{course.heading}</h1>
          <p class="mt-1 text-sm font-semibold text-(--muted)">{stats.units} units / {stats.items} items</p>
        </div>
      </div>
      <p class="mt-5 max-w-[70ch]">{course.summary}</p>
      <div class="mt-6">
        <CourseProgressPanel client:load courseId={course.id} pageIds={itemPages(course).map(page => page.id)} />
      </div>
    </section>

    <h2>Course Objectives</h2>
    <ul class="mt-4 grid list-none gap-2 pl-0">
      {course.objectives.map(objective => (
        <li class="mt-0 flex gap-3">
          <Icon name="check" size={20} class="mt-1 shrink-0 text-(--accent)" />
          <span>{objective}</span>
        </li>
      ))}
    </ul>

    {course.intro_html && (
      <div class="panel mt-10 [&>:first-child]:mt-0 [&_:is(h2,h3):first-child]:mt-0">
        <Fragment set:html={sanitize(course.intro_html, { shiftHeadings: true })} />
      </div>
    )}

    <CourseUnits client:load courseId={course.id} units={unitViews(course)} />
  </div>
</Base>
