---
import { ICON_PATHS, type IconName } from '../lib/icons'

interface Props {
  name: IconName
  size?: number
  class?: string
}

const { name, size = 22, class: className } = Astro.props
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={ICON_PATHS[name]}
/>
